// Shema baze ERP-WMS.
//
// Pravila (vidi CLAUDE.md):
// - iznosi: Decimal @db.Decimal(14, 2), nikad Float
// - poslovni datumi: DateTime @db.Date (YYYY-MM-DD po Europe/Zagreb)
// - svaki poslovni model ima firmaId (izolacija firmi, od koraka 0.2)
// - migracije samo dodaju; nikad ne brišu stupce ni podatke

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 0.2 Firma, korisnici, prijava ───────────────────────────────────────────

model Firma {
  id        String   @id @default(uuid(7)) @db.Uuid
  naziv     String
  oib       String   @unique @db.Char(11)
  aktivna   Boolean  @default(true)
  /// boja firme u sučelju (#rrggbb); tekst na njoj bira se po kontrastu
  boja      String?  @db.Char(7)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)

  clanstva ClanstvoFirme[]
  sesije   Sesija[]
  uloge    Uloga[]
  dnevnik  Dnevnik[]

  kategorije    Kategorija[]
  proizvodjaci  Proizvodjac[]
  modeli        ModelUredaja[]
  skladista     Skladiste[]
  stanjaRobe    StanjeRobe[]
  usluge        Usluga[]
}

/// Korisnik je jedan za sve firme; kojoj firmi smije pristupiti određuje ClanstvoFirme.
model Korisnik {
  id            String    @id @default(uuid(7)) @db.Uuid
  ime           String
  email         String    @unique
  lozinkaHash   String
  aktivan       Boolean   @default(true)
  zadnjaPrijava DateTime? @db.Timestamptz(3)
  stvoreno      DateTime  @default(now()) @db.Timestamptz(3)

  clanstva ClanstvoFirme[]
  sesije   Sesija[]
}

model ClanstvoFirme {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  korisnikId String   @db.Uuid
  ulogaId    String   @db.Uuid
  /// iznimke po korisniku u odnosu na ulogu: { moduli: { prodaja: "pregled" }, posebna: { costs: true } }
  iznimke    Json     @default("{}")
  aktivno    Boolean  @default(true)
  stvoreno   DateTime @default(now()) @db.Timestamptz(3)

  firma    Firma    @relation(fields: [firmaId], references: [id])
  korisnik Korisnik @relation(fields: [korisnikId], references: [id])
  /// složeni ključ: uloga mora biti iz iste firme (baza to jamči)
  uloga    Uloga    @relation(fields: [firmaId, ulogaId], references: [firmaId, id])

  @@unique([firmaId, korisnikId])
  @@index([korisnikId])
  @@index([ulogaId])
}

// ─── 0.3 Uloge i prava ───────────────────────────────────────────────────────

/// Uloga s pravima po modulima (vidi src/domain/prava.ts). Sustavna (Administrator) se ne mijenja.
model Uloga {
  id       String   @id @default(uuid(7)) @db.Uuid
  firmaId  String   @db.Uuid
  naziv    String
  opis     String   @default("")
  /// { moduli: { prodaja: "operativno", ... }, posebna: { costs: false, ... } }
  prava    Json
  sustavna Boolean  @default(false)
  stvoreno DateTime @default(now()) @db.Timestamptz(3)

  firma    Firma           @relation(fields: [firmaId], references: [id])
  clanstva ClanstvoFirme[]

  @@unique([firmaId, naziv])
  @@unique([firmaId, id])
}

/// Prijava na uređaju. U bazi je samo SHA-256 tokena; sam token je samo u kolačiću.
model Sesija {
  id              String   @id @db.Char(64)
  korisnikId      String   @db.Uuid
  firmaId         String   @db.Uuid
  istjece         DateTime @db.Timestamptz(3)
  zadnjaAktivnost DateTime @default(now()) @db.Timestamptz(3)
  ip              String?
  preglednik      String?
  stvoreno        DateTime @default(now()) @db.Timestamptz(3)

  korisnik Korisnik @relation(fields: [korisnikId], references: [id])
  firma    Firma    @relation(fields: [firmaId], references: [id])

  @@index([korisnikId])
  @@index([istjece])
}

/// Svaki pokušaj prijave (uspješan i neuspješan) — za ograničenje pokušaja.
model PokusajPrijave {
  id      String   @id @default(uuid(7)) @db.Uuid
  email   String
  ip      String
  uspjeh  Boolean
  vrijeme DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, vrijeme])
  @@index([ip, vrijeme])
}

// ─── 0.4 Dnevnik promjena ──────────────────────────────────────────────────────

/// Tko je što promijenio, kada i razlika. Zapisuje se u istoj transakciji kao promjena.
model Dnevnik {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  /// null = sustav (automatsko izdavanje, uvoz…)
  korisnikId String?  @db.Uuid
  korisnik   String   @default("Sustav")
  vrijeme    DateTime @default(now()) @db.Timestamptz(3)
  /// npr. "korisnici.uredi"
  radnja     String
  /// npr. "Korisnik", "Uredaj"
  entitet    String
  entitetId  String?
  opis       String
  /// [{ polje, staro, novo, osjetljivo? }]
  promjene   Json     @default("[]")
  /// mala slova, bez osjetljivih vrijednosti
  pretraga   String   @default("")
  ip         String?

  firma Firma @relation(fields: [firmaId], references: [id])

  @@index([firmaId, vrijeme(sort: Desc)])
  @@index([firmaId, entitet, entitetId, vrijeme(sort: Desc)])
  @@index([firmaId, korisnikId, vrijeme(sort: Desc)])
}

// ─── 1.1 Šifrarnici ────────────────────────────────────────────────────────────
// Naziv je jedinstven u firmi (bez obzira na velika slova) — provjerava servis pod zaključavanjem.
// Deaktivacija umjesto brisanja: povijest (uređaji, računi) ostaje; brisanje samo neiskorištenog.

model Kategorija {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma  Firma          @relation(fields: [firmaId], references: [id])
  modeli ModelUredaja[]

  @@index([firmaId, naziv])
  @@unique([firmaId, id])
}

model Proizvodjac {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma  Firma          @relation(fields: [firmaId], references: [id])
  modeli ModelUredaja[]

  @@index([firmaId, naziv])
  @@unique([firmaId, id])
}

/// Model uređaja (npr. Lenovo ThinkPad T14 Gen 4). Naziv jedinstven unutar proizvođača.
model ModelUredaja {
  id                String   @id @default(uuid(7)) @db.Uuid
  firmaId           String   @db.Uuid
  proizvodjacId     String   @db.Uuid
  kategorijaId      String   @db.Uuid
  naziv             String
  sifra             String?
  /// KPD za prodaju (npr. 26.20.11) i za najam (usluga, npr. 77.33.11)
  kpdProdaja        String?
  kpdNajam          String?
  jamstvoMjeseci    Int      @default(24)
  preporucenaCijena Decimal? @db.Decimal(14, 2)
  /// ciljana marža u % — osjetljivo (pravo „costs“)
  marza             Decimal? @db.Decimal(7, 2)
  opis              String?
  aktivan           Boolean  @default(true)
  stvoreno          DateTime @default(now()) @db.Timestamptz(3)
  azurirano         DateTime @updatedAt @db.Timestamptz(3)

  firma       Firma       @relation(fields: [firmaId], references: [id])
  proizvodjac Proizvodjac @relation(fields: [firmaId, proizvodjacId], references: [firmaId, id])
  kategorija  Kategorija  @relation(fields: [firmaId, kategorijaId], references: [firmaId, id])

  @@index([firmaId, naziv])
  @@index([proizvodjacId])
  @@index([kategorijaId])
  @@unique([firmaId, id])
}

model Skladiste {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  adresa    String?
  /// zadano skladište za zaprimanje
  zadano    Boolean  @default(false)
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma Firma @relation(fields: [firmaId], references: [id])

  @@index([firmaId, naziv])
  @@unique([firmaId, id])
}

/// Stanje robe (Novo, Rabljeno, Obnovljeno, Neispravno…) — neovisno o statusu uređaja.
model StanjeRobe {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma Firma @relation(fields: [firmaId], references: [id])

  @@index([firmaId, naziv])
  @@unique([firmaId, id])
}

/// Usluga (instalacija, sat servisa, dostava…) za stavke ponuda i računa.
model Usluga {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  sifra     String?
  jedinica  String   @default("kom")
  cijena    Decimal? @db.Decimal(14, 2)
  kpd       String?
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma Firma @relation(fields: [firmaId], references: [id])

  @@index([firmaId, naziv])
  @@unique([firmaId, id])
}

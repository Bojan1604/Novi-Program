// Shema baze ERP-WMS.
//
// Pravila (vidi CLAUDE.md):
// - iznosi: Decimal @db.Decimal(14, 2), nikad Float
// - poslovni datumi: DateTime @db.Date (YYYY-MM-DD po Europe/Zagreb)
// - svaki poslovni model ima firmaId (izolacija firmi, od koraka 0.2)
// - migracije samo dodaju; nikad ne brišu stupce ni podatke

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 0.2 Firma, korisnici, prijava ───────────────────────────────────────────

model Firma {
  id       String   @id @default(uuid(7)) @db.Uuid
  naziv    String
  oib      String   @unique @db.Char(11)
  aktivna  Boolean  @default(true)
  /// boja firme u sučelju (#rrggbb); tekst na njoj bira se po kontrastu
  boja     String?  @db.Char(7)
  stvoreno DateTime @default(now()) @db.Timestamptz(3)

  /// podaci za dokumente (izdani dokument ih pamti u trenutku izdavanja)
  adresa            String?
  postanskiBroj     String?
  mjesto            String?
  email             String?
  telefon           String?
  web               String?
  iban              String?
  banka             String?
  /// u sustavu PDV-a; obračun po naplaćenoj naknadi
  uSustavuPdv       Boolean   @default(true)
  pdvPoNaplacenoj   Boolean   @default(false)
  /// fiskalizacija: oznaka poslovnog prostora i naplatnog uređaja (broj računa 12/PP1/1)
  oznakaProstora    String    @default("PP1")
  oznakaUredaja     String    @default("1")
  /// zadani rok plaćanja (dana) i tekst u podnožju dokumenata
  rokPlacanjaDana   Int       @default(15)
  podnozje          String?
  /// logo na dokumentima (6.5): zapis u LogoFirme (nepromjenjiv) — izdani dokument pamti id loga iz snimke
  logoId            String?   @db.Uuid
  /// zadani KPD kad ga model/usluga nema (roba, usluga, najam)
  kpdRoba           String?
  kpdUsluga         String?
  kpdNajam          String?
  /// e-pošta: SMTP (lozinka šifrirana, src/lib/tajne.ts); bez SMTP-a slanje ide preko programa za poštu (mailto)
  smtpHost          String?
  smtpPort          Int?
  smtpSigurno       Boolean   @default(true)
  smtpKorisnik      String?
  smtpLozinka       String?
  epostaPosiljatelj String?
  epostaKopija      String?
  /// e-pošta knjigovođe (za slanje mjesečnog paketa)
  epostaKnjigovodje String?
  /// fiskalizacija (korak 2.10): ISKLJUCENA, DEMO, TEST, PRODUKCIJA; certifikat .p12 i lozinka šifrirani (src/lib/tajne.ts)
  fiskalNacin       String    @default("DEMO")
  fiskalCertifikat  String?
  fiskalLozinka     String?
  fiskalCertNaziv   String?
  fiskalCertVrijedi DateTime? @db.Timestamptz(3)

  clanstva ClanstvoFirme[]
  sesije   Sesija[]
  uloge    Uloga[]
  dnevnik  Dnevnik[]

  kategorije           Kategorija[]
  proizvodjaci         Proizvodjac[]
  modeli               ModelUredaja[]
  skladista            Skladiste[]
  stanjaRobe           StanjeRobe[]
  usluge               Usluga[]
  partneri             Partner[]
  poslovnice           Poslovnica[]
  cjenici              Cjenik[]
  stavkeCjenika        StavkaCjenika[]
  uredaji              Uredaj[]
  dogadaji             DogadajUredaja[]
  brojaci              Brojac[]
  primke               Primka[]
  prilozi              Prilog[]
  skladisniDokumenti   SkladisniDokument[]
  prodajniDokumenti    ProdajniDokument[]
  eRacuni              ERacun[]
  eIzvjestaji          EIzvjestaj[]
  ugovoriNajma         UgovorNajma[]
  planoviNajma         UredajNaUgovoru[]
  cijeneNajma          CijenaNajma[]
  mjeseciNajma         MjesecNajma[]
  rateNajma            RataNajma[]
  narudzbenice         Narudzbenica[]
  stavkeNarudzbenica   StavkaNarudzbenice[]
  stavkeDokumenata     StavkaSkladisnogDokumenta[]
  odobrenja            Odobrenje[]
  inventure            Inventura[]
  stavkeInventure      StavkaInventure[]
  stavkeProdaje        StavkaProdajnogDokumenta[]
  uredajiNaStavkama    UredajNaStavci[]
  uplate               Uplata[]
  slanjaEposte         SlanjeEposte[]
  placanjaUlaznih      PlacanjeUlaznog[]
  kategorijeTroska     KategorijaTroska[]
  troskovi             Trosak[]
  ponavljajuciTroskovi PonavljajuciTrosak[]
  ulazniRacuni         UlazniRacun[]
  predajeKnjigovodji   PredajaKnjigovodji[]
  servisniNalozi       ServisniNalog[]
  dogadajiServisa      DogadajServisa[]
  korisniciPortala     KorisnikPortala[]
  sesijePortala        SesijaPortala[]
  mdmOrganizacije      MdmOrganizacija[]
  mdmUredaji           MdmUredaj[]
  mdmProfili           MdmProfil[]
  mdmAplikacije        MdmAplikacija[]
  mdmDodjele           MdmDodjela[]
  mdmDatoteke          MdmDatoteka[]
  mdmNaredbe           MdmNaredba[]
  mdmZapisi            MdmZapis[]
  mdmSnimke            MdmSnimka[]
  logotipi             LogoFirme[]
  sigurnosneKopije     SigurnosnaKopija[]
}

/// Korisnik je jedan za sve firme; kojoj firmi smije pristupiti određuje ClanstvoFirme.
model Korisnik {
  id              String    @id @default(uuid(7)) @db.Uuid
  ime             String
  email           String    @unique
  lozinkaHash     String
  /// OIB operatera na fiskaliziranim računima (bez njega se šalje OIB firme)
  oib             String?   @db.Char(11)
  aktivan         Boolean   @default(true)
  zadnjaPrijava   DateTime? @db.Timestamptz(3)
  stvoreno        DateTime  @default(now()) @db.Timestamptz(3)
  /// prijava u dva koraka (6.4): TOTP tajna šifrirana (src/lib/tajne.ts); uključena tek nakon potvrde kodom
  totpTajna       String?
  totpUkljucen    Boolean   @default(false)
  /// zadnji iskorišteni vremenski korak — isti kod ne prolazi dvaput
  totpZadnjiKorak Int?

  clanstva       ClanstvoFirme[]
  sesije         Sesija[]
  rezervniKodovi RezervniKod[]
  drugiKoraci    PrijavaDrugiKorak[]
}

/// Jednokratni rezervni kod za prijavu u dva koraka (samo hash).
model RezervniKod {
  id         String    @id @default(uuid(7)) @db.Uuid
  korisnikId String    @db.Uuid
  hash       String
  iskoristen DateTime? @db.Timestamptz(3)

  korisnik Korisnik @relation(fields: [korisnikId], references: [id], onDelete: Cascade)

  @@index([korisnikId])
}

/// Prijava čeka drugi korak (lozinka je točna, čeka se kod) — kratko traje, najviše 5 pokušaja.
model PrijavaDrugiKorak {
  /// hash tokena iz kolačića „erp_2k“
  id         String   @id
  korisnikId String   @db.Uuid
  istjece    DateTime @db.Timestamptz(3)
  pokusaja   Int      @default(0)
  ip         String?
  preglednik String?
  stvoreno   DateTime @default(now()) @db.Timestamptz(3)

  korisnik Korisnik @relation(fields: [korisnikId], references: [id], onDelete: Cascade)

  @@index([korisnikId])
}

model ClanstvoFirme {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  korisnikId String   @db.Uuid
  ulogaId    String   @db.Uuid
  /// iznimke po korisniku u odnosu na ulogu: { moduli: { prodaja: "pregled" }, posebna: { costs: true } }
  iznimke    Json     @default("{}")
  aktivno    Boolean  @default(true)
  stvoreno   DateTime @default(now()) @db.Timestamptz(3)

  firma    Firma    @relation(fields: [firmaId], references: [id])
  korisnik Korisnik @relation(fields: [korisnikId], references: [id])
  /// složeni ključ: uloga mora biti iz iste firme (baza to jamči)
  uloga    Uloga    @relation(fields: [firmaId, ulogaId], references: [firmaId, id])

  @@unique([firmaId, korisnikId])
  @@index([korisnikId])
  @@index([ulogaId])
}

// ─── 0.3 Uloge i prava ───────────────────────────────────────────────────────

/// Uloga s pravima po modulima (vidi src/domain/prava.ts). Sustavna (Administrator) se ne mijenja.
model Uloga {
  id       String   @id @default(uuid(7)) @db.Uuid
  firmaId  String   @db.Uuid
  naziv    String
  opis     String   @default("")
  /// { moduli: { prodaja: "operativno", ... }, posebna: { costs: false, ... } }
  prava    Json
  sustavna Boolean  @default(false)
  stvoreno DateTime @default(now()) @db.Timestamptz(3)

  firma    Firma           @relation(fields: [firmaId], references: [id])
  clanstva ClanstvoFirme[]

  @@unique([firmaId, naziv])
  @@unique([firmaId, id])
}

/// Prijava na uređaju. U bazi je samo SHA-256 tokena; sam token je samo u kolačiću.
model Sesija {
  id              String   @id @db.Char(64)
  korisnikId      String   @db.Uuid
  firmaId         String   @db.Uuid
  istjece         DateTime @db.Timestamptz(3)
  zadnjaAktivnost DateTime @default(now()) @db.Timestamptz(3)
  ip              String?
  preglednik      String?
  stvoreno        DateTime @default(now()) @db.Timestamptz(3)

  korisnik Korisnik @relation(fields: [korisnikId], references: [id])
  firma    Firma    @relation(fields: [firmaId], references: [id])

  @@index([korisnikId])
  @@index([istjece])
}

/// Svaki pokušaj prijave (uspješan i neuspješan) — za ograničenje pokušaja.
model PokusajPrijave {
  id      String   @id @default(uuid(7)) @db.Uuid
  email   String
  ip      String
  uspjeh  Boolean
  vrijeme DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, vrijeme])
  @@index([ip, vrijeme])
}

// ─── 0.4 Dnevnik promjena ──────────────────────────────────────────────────────

/// Tko je što promijenio, kada i razlika. Zapisuje se u istoj transakciji kao promjena.
model Dnevnik {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  /// null = sustav (automatsko izdavanje, uvoz…)
  korisnikId String?  @db.Uuid
  korisnik   String   @default("Sustav")
  vrijeme    DateTime @default(now()) @db.Timestamptz(3)
  /// npr. "korisnici.uredi"
  radnja     String
  /// npr. "Korisnik", "Uredaj"
  entitet    String
  entitetId  String?
  opis       String
  /// [{ polje, staro, novo, osjetljivo? }]
  promjene   Json     @default("[]")
  /// mala slova, bez osjetljivih vrijednosti
  pretraga   String   @default("")
  ip         String?

  firma Firma @relation(fields: [firmaId], references: [id])

  @@index([firmaId, vrijeme(sort: Desc)])
  @@index([firmaId, entitet, entitetId, vrijeme(sort: Desc)])
  @@index([firmaId, korisnikId, vrijeme(sort: Desc)])
}

// ─── 1.1 Šifrarnici ────────────────────────────────────────────────────────────
// Naziv je jedinstven u firmi (bez obzira na velika slova) — provjerava servis pod zaključavanjem.
// Deaktivacija umjesto brisanja: povijest (uređaji, računi) ostaje; brisanje samo neiskorištenog.

model Kategorija {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma  Firma          @relation(fields: [firmaId], references: [id])
  modeli ModelUredaja[]

  @@unique([firmaId, id])
  @@index([firmaId, naziv])
}

model Proizvodjac {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma  Firma          @relation(fields: [firmaId], references: [id])
  modeli ModelUredaja[]

  @@unique([firmaId, id])
  @@index([firmaId, naziv])
}

/// Model uređaja (npr. Lenovo ThinkPad T14 Gen 4). Naziv jedinstven unutar proizvođača.
model ModelUredaja {
  id                String   @id @default(uuid(7)) @db.Uuid
  firmaId           String   @db.Uuid
  proizvodjacId     String   @db.Uuid
  kategorijaId      String   @db.Uuid
  naziv             String
  sifra             String?
  /// KPD za prodaju (npr. 26.20.11) i za najam (usluga, npr. 77.33.11)
  kpdProdaja        String?
  kpdNajam          String?
  jamstvoMjeseci    Int      @default(24)
  preporucenaCijena Decimal? @db.Decimal(14, 2)
  /// ciljana marža u % — osjetljivo (pravo „costs“)
  marza             Decimal? @db.Decimal(7, 2)
  opis              String?
  aktivan           Boolean  @default(true)
  stvoreno          DateTime @default(now()) @db.Timestamptz(3)
  azurirano         DateTime @updatedAt @db.Timestamptz(3)

  firma         Firma                      @relation(fields: [firmaId], references: [id])
  proizvodjac   Proizvodjac                @relation(fields: [firmaId, proizvodjacId], references: [firmaId, id])
  kategorija    Kategorija                 @relation(fields: [firmaId, kategorijaId], references: [firmaId, id])
  cijene        StavkaCjenika[]
  uredaji       Uredaj[]
  stavkeProdaje StavkaProdajnogDokumenta[]

  stavkeNarudzbenica StavkaNarudzbenice[]

  @@unique([firmaId, id])
  @@index([firmaId, naziv])
  @@index([proizvodjacId])
  @@index([kategorijaId])
}

model Skladiste {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  adresa    String?
  /// zadano skladište za zaprimanje
  zadano    Boolean  @default(false)
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma       Firma               @relation(fields: [firmaId], references: [id])
  uredaji     Uredaj[]
  primke      Primka[]
  dokumentiIz SkladisniDokument[] @relation("DokumentIz")
  dokumentiU  SkladisniDokument[] @relation("DokumentU")
  inventure   Inventura[]

  @@unique([firmaId, id])
  @@index([firmaId, naziv])
}

/// Stanje robe (Novo, Rabljeno, Obnovljeno, Neispravno…) — neovisno o statusu uređaja.
model StanjeRobe {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma   Firma    @relation(fields: [firmaId], references: [id])
  uredaji Uredaj[]

  @@unique([firmaId, id])
  @@index([firmaId, naziv])
}

/// Usluga (instalacija, sat servisa, dostava…) za stavke ponuda i računa.
model Usluga {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  sifra     String?
  jedinica  String   @default("kom")
  cijena    Decimal? @db.Decimal(14, 2)
  kpd       String?
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma         Firma                      @relation(fields: [firmaId], references: [id])
  cijene        StavkaCjenika[]
  stavkeProdaje StavkaProdajnogDokumenta[]

  @@unique([firmaId, id])
  @@index([firmaId, naziv])
}

// ─── 1.2 Partneri i cjenici ────────────────────────────────────────────────────

/// Kupac i/ili dobavljač. OIB jedinstven u firmi (provjerava servis pod zaključavanjem).
model Partner {
  id               String    @id @default(uuid(7)) @db.Uuid
  firmaId          String    @db.Uuid
  naziv            String
  kupac            Boolean   @default(true)
  dobavljac        Boolean   @default(false)
  /// ISO 3166-1 alpha-2
  drzava           String    @default("HR") @db.Char(2)
  oib              String?   @db.Char(11)
  /// PDV broj s prefiksom države (DE123456789); za HR = HR + OIB
  pdvBroj          String?
  adresa           String?
  postanskiBroj    String?
  mjesto           String?
  email            String?
  telefon          String?
  /// adresa za eRačun (9934:OIB) i je li partner u sustavu eRačuna (AMS)
  eRacunAdresa     String?
  eRacunAktivan    Boolean?
  eRacunProvjereno DateTime? @db.Timestamptz(3)
  /// ručni porezni status (DOMACI, EU_OBVEZNIK, EU_NEOBVEZNIK, TRECA_ZEMLJA); null = prema državi i PDV broju
  pdvStatus        String?
  /// VIES provjera PDV broja
  viesValjan       Boolean?
  viesProvjereno   DateTime? @db.Timestamptz(3)
  rokPlacanjaDana  Int       @default(15)
  cjenikId         String?   @db.Uuid
  napomena         String?
  aktivan          Boolean   @default(true)
  stvoreno         DateTime  @default(now()) @db.Timestamptz(3)
  azurirano        DateTime  @updatedAt @db.Timestamptz(3)

  firma              Firma               @relation(fields: [firmaId], references: [id])
  cjenik             Cjenik?             @relation(fields: [firmaId, cjenikId], references: [firmaId, id])
  poslovnice         Poslovnica[]
  uredaji            Uredaj[]
  primke             Primka[]
  skladisniDokumenti SkladisniDokument[]
  prodajniDokumenti  ProdajniDokument[]
  narudzbenice       Narudzbenica[]
  ugovoriNajma       UgovorNajma[]
  ulazniRacuni       UlazniRacun[]
  servisniNalozi     ServisniNalog[]
  korisniciPortala   KorisnikPortala[]
  mdmOrganizacije    MdmOrganizacija[]

  @@unique([firmaId, id])
  @@index([firmaId, naziv])
  @@index([firmaId, oib])
}

/// Poslovnica / adresa isporuke partnera (uređaji u najmu stoje na poslovnici).
model Poslovnica {
  id            String   @id @default(uuid(7)) @db.Uuid
  firmaId       String   @db.Uuid
  partnerId     String   @db.Uuid
  naziv         String
  adresa        String?
  postanskiBroj String?
  mjesto        String?
  kontakt       String?
  telefon       String?
  aktivan       Boolean  @default(true)
  stvoreno      DateTime @default(now()) @db.Timestamptz(3)
  azurirano     DateTime @updatedAt @db.Timestamptz(3)

  firma             Firma              @relation(fields: [firmaId], references: [id])
  partner           Partner            @relation(fields: [firmaId, partnerId], references: [firmaId, id])
  uredaji           Uredaj[]
  prodajniDokumenti ProdajniDokument[]

  ugovoriNajma UgovorNajma[]

  @@unique([firmaId, id])
  @@index([partnerId])
}

/// Cjenik kupca: posebne cijene modela i usluga (bez PDV-a); za ostalo vrijedi preporučena cijena.
model Cjenik {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  naziv     String
  opis      String?
  /// popust na preporučenu cijenu za stavke koje nisu u cjeniku (stotinke %: 500 = 5 %)
  popust    Decimal? @db.Decimal(7, 2)
  aktivan   Boolean  @default(true)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma    Firma           @relation(fields: [firmaId], references: [id])
  stavke   StavkaCjenika[]
  partneri Partner[]

  @@unique([firmaId, id])
  @@index([firmaId, naziv])
}

model StavkaCjenika {
  id        String   @id @default(uuid(7)) @db.Uuid
  firmaId   String   @db.Uuid
  cjenikId  String   @db.Uuid
  modelId   String?  @db.Uuid
  uslugaId  String?  @db.Uuid
  cijena    Decimal  @db.Decimal(14, 2)
  stvoreno  DateTime @default(now()) @db.Timestamptz(3)
  azurirano DateTime @updatedAt @db.Timestamptz(3)

  firma  Firma         @relation(fields: [firmaId], references: [id])
  cjenik Cjenik        @relation(fields: [firmaId, cjenikId], references: [firmaId, id])
  model  ModelUredaja? @relation(fields: [firmaId, modelId], references: [firmaId, id])
  usluga Usluga?       @relation(fields: [firmaId, uslugaId], references: [firmaId, id])

  @@unique([cjenikId, modelId])
  @@unique([cjenikId, uslugaId])
  @@index([modelId])
  @@index([uslugaId])
}

// ─── 1.3 Uređaji i stanja ──────────────────────────────────────────────────────

/// Stanje uređaja — mijenja se SAMO kroz src/domain/stanja-uredaja.ts (prijelaz) i servis promjene stanja.
enum StanjeUredaja {
  U_DOLASKU
  NA_SKLADISTU
  REZERVIRAN
  PRODAN
  U_NAJMU
  NA_SERVISU
  OTPISAN
  /// zamjenski uređaj kod klijenta dok je njegov na servisu
  ZAMJENSKI
}

/// Uređaj (serijski broj) — središnji objekt: prodaja, najam i servis mijenjaju njegovo stanje.
model Uredaj {
  id                   String         @id @default(uuid(7)) @db.Uuid
  firmaId              String         @db.Uuid
  /// velika slova, bez razmaka; jedinstven u firmi
  serijski             String
  modelId              String         @db.Uuid
  stanje               StanjeUredaja
  stanjePrijeServisa   StanjeUredaja?
  /// gdje je fizički (null = nije kod nas: kod kupca, u najmu, otpisan)
  skladisteId          String?        @db.Uuid
  stanjeRobeId         String?        @db.Uuid
  /// kupac ili najmoprimac kod kojeg je uređaj
  partnerId            String?        @db.Uuid
  poslovnicaId         String?        @db.Uuid
  /// primka kojom je zaprimljen
  primkaId             String?        @db.Uuid
  /// stavka narudžbenice po kojoj je zaprimljen
  stavkaNarudzbeniceId String?        @db.Uuid
  /// nabavna cijena bez PDV-a — osjetljivo (pravo „costs“)
  nabavnaCijena        Decimal?       @db.Decimal(14, 2)
  nabavniDatum         DateTime?      @db.Date
  jamstvoDo            DateTime?      @db.Date
  cpu                  String?
  ram                  String?
  disk                 String?
  ekran                String?
  os                   String?
  napomena             String?
  /// raste sa svakom promjenom (zaštita od istovremenih izmjena)
  verzija              Int            @default(0)
  stvoreno             DateTime       @default(now()) @db.Timestamptz(3)
  azurirano            DateTime       @updatedAt @db.Timestamptz(3)

  firma            Firma                       @relation(fields: [firmaId], references: [id])
  model            ModelUredaja                @relation(fields: [firmaId, modelId], references: [firmaId, id])
  skladiste        Skladiste?                  @relation(fields: [firmaId, skladisteId], references: [firmaId, id])
  stanjeRobe       StanjeRobe?                 @relation(fields: [firmaId, stanjeRobeId], references: [firmaId, id])
  partner          Partner?                    @relation(fields: [firmaId, partnerId], references: [firmaId, id])
  poslovnica       Poslovnica?                 @relation(fields: [firmaId, poslovnicaId], references: [firmaId, id])
  primka           Primka?                     @relation(fields: [firmaId, primkaId], references: [firmaId, id])
  dogadaji         DogadajUredaja[]
  stavkeDokumenata StavkaSkladisnogDokumenta[]
  stavkeInventure  StavkaInventure[]
  stavkeProdaje    StavkaProdajnogDokumenta[]
  naStavkama       UredajNaStavci[]

  stavkaNarudzbenice StavkaNarudzbenice? @relation(fields: [firmaId, stavkaNarudzbeniceId], references: [firmaId, id])
  naUgovorima        UredajNaUgovoru[]
  servisniNalozi     ServisniNalog[]     @relation("NalogUredaj")
  zamjeneNaNalozima  ServisniNalog[]     @relation("NalogZamjena")
  mdmUredaji         MdmUredaj[]

  @@unique([firmaId, serijski])
  @@unique([firmaId, id])
  @@index([firmaId, stanje])
  @@index([firmaId, modelId])
  @@index([firmaId, skladisteId])
  @@index([firmaId, partnerId])
  @@index([firmaId, stvoreno(sort: Desc)])
  @@index([primkaId])
  /// pretraga po dijelu serijskog broja (LIKE '%…%') — pg_trgm
  @@index([serijski(ops: raw("gin_trgm_ops"))], type: Gin, map: "Uredaj_serijski_trgm")
  @@index([firmaId, nabavniDatum(sort: Desc)])
  @@index([firmaId, jamstvoDo])
  @@index([firmaId, stavkaNarudzbeniceId])
}

/// Povijest uređaja: svaka promjena stanja ili lokacije.
model DogadajUredaja {
  id            String         @id @default(uuid(7)) @db.Uuid
  firmaId       String         @db.Uuid
  uredajId      String         @db.Uuid
  vrijeme       DateTime       @default(now()) @db.Timestamptz(3)
  /// radnja iz stanja-uredaja.ts (zaprimanje, prodaja, najam…)
  radnja        String
  staroStanje   StanjeUredaja?
  novoStanje    StanjeUredaja?
  skladisteOdId String?        @db.Uuid
  skladisteDoId String?        @db.Uuid
  partnerId     String?        @db.Uuid
  /// dokument koji je uzrokovao promjenu (primka, račun, ugovor, servisni nalog…)
  dokumentVrsta String?
  dokumentId    String?        @db.Uuid
  dokumentBroj  String?
  opis          String?
  korisnikId    String?        @db.Uuid
  korisnik      String         @default("Sustav")

  firma  Firma  @relation(fields: [firmaId], references: [id])
  uredaj Uredaj @relation(fields: [firmaId, uredajId], references: [firmaId, id])

  @@index([uredajId, vrijeme(sort: Desc)])
  @@index([firmaId, dokumentVrsta, dokumentId])
}

// ─── 1.4 Zaprimanje ────────────────────────────────────────────────────────────

/// Brojač dokumenata po vrsti i godini: broj se uzima u istoj transakciji kao dokument,
/// pa neuspjela radnja ne ostavlja rupu, a dva istovremena dokumenta ne dobiju isti broj.
model Brojac {
  firmaId     String    @db.Uuid
  vrsta       String
  godina      Int
  zadnji      Int       @default(0)
  /// datum zadnjeg izdanog dokumenta (sljedeći ne smije biti raniji)
  zadnjiDatum DateTime? @db.Date

  firma Firma @relation(fields: [firmaId], references: [id])

  @@id([firmaId, vrsta, godina])
}

/// Primka: zaprimanje uređaja na skladište.
model Primka {
  id                 String   @id @default(uuid(7)) @db.Uuid
  firmaId            String   @db.Uuid
  /// PRI-12/2026
  broj               String
  godina             Int
  redni              Int
  datum              DateTime @db.Date
  dobavljacId        String?  @db.Uuid
  skladisteId        String   @db.Uuid
  /// dokument dobavljača (otpremnica, račun)
  dokumentDobavljaca String?
  napomena           String?
  /// knjiži nabavnu vrijednost u troškove (faza 4)
  knjiziUTroskove    Boolean  @default(false)
  /// narudžbenica po kojoj je zaprimljeno (korak 4.2)
  narudzbenicaId     String?  @db.Uuid
  brojUredaja        Int
  /// zbroj nabavnih cijena — osjetljivo (pravo „costs“)
  nabavnaVrijednost  Decimal? @db.Decimal(14, 2)
  /// IZDANA ili STORNIRANA
  status             String   @default("IZDANA")
  korisnikId         String?  @db.Uuid
  korisnik           String   @default("Sustav")
  stvoreno           DateTime @default(now()) @db.Timestamptz(3)
  azurirano          DateTime @updatedAt @db.Timestamptz(3)

  firma        Firma         @relation(fields: [firmaId], references: [id])
  dobavljac    Partner?      @relation(fields: [firmaId, dobavljacId], references: [firmaId, id])
  skladiste    Skladiste     @relation(fields: [firmaId, skladisteId], references: [firmaId, id])
  narudzbenica Narudzbenica? @relation(fields: [firmaId, narudzbenicaId], references: [firmaId, id])
  uredaji      Uredaj[]
  ulazniRacuni UlazniRacun[]

  @@unique([firmaId, id])
  @@unique([firmaId, godina, redni])
  @@index([firmaId, datum(sort: Desc)])
}

/// Datoteka uz zapis (uređaj, ugovor, račun, servisni nalog…). Sadržaj je u bazi — ide u sigurnosnu kopiju.
model Prilog {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  /// vrsta zapisa (NAZIVI_ENTITETA) i njegov id
  entitet    String
  entitetId  String   @db.Uuid
  naziv      String
  /// MIME vrsta određena iz nastavka
  vrsta      String
  velicina   Int
  sadrzaj    Bytes
  /// vidljiv klijentu na portalu (servis)
  javno      Boolean  @default(false)
  korisnikId String?  @db.Uuid
  korisnik   String   @default("Sustav")
  stvoreno   DateTime @default(now()) @db.Timestamptz(3)

  firma Firma @relation(fields: [firmaId], references: [id])

  @@unique([firmaId, id])
  @@index([firmaId, entitet, entitetId])
}

/// Skladišni dokument bez prodaje: međuskladišnica (MSK), izlaz (IZL — otpis, povrat dobavljaču…), povrat na skladište (POV).
model SkladisniDokument {
  id            String   @id @default(uuid(7)) @db.Uuid
  firmaId       String   @db.Uuid
  /// MEDJUSKLADISNICA, IZLAZ, POVRAT
  vrsta         String
  /// MSK-3/2026
  broj          String
  godina        Int
  redni         Int
  datum         DateTime @db.Date
  skladisteIzId String?  @db.Uuid
  skladisteUId  String?  @db.Uuid
  /// od koga se vraća (najmoprimac) ili kome ide (dobavljač)
  partnerId     String?  @db.Uuid
  razlog        String?
  napomena      String?
  brojUredaja   Int
  /// IZDAN, CEKA_ODOBRENJE, ODBIJEN
  status        String   @default("IZDAN")
  korisnikId    String?  @db.Uuid
  korisnik      String   @default("Sustav")
  stvoreno      DateTime @default(now()) @db.Timestamptz(3)
  azurirano     DateTime @updatedAt @db.Timestamptz(3)

  firma       Firma                       @relation(fields: [firmaId], references: [id])
  skladisteIz Skladiste?                  @relation("DokumentIz", fields: [firmaId, skladisteIzId], references: [firmaId, id])
  skladisteU  Skladiste?                  @relation("DokumentU", fields: [firmaId, skladisteUId], references: [firmaId, id])
  partner     Partner?                    @relation(fields: [firmaId, partnerId], references: [firmaId, id])
  stavke      StavkaSkladisnogDokumenta[]

  @@unique([firmaId, id])
  @@unique([firmaId, vrsta, godina, redni])
  @@index([firmaId, datum(sort: Desc)])
  @@index([firmaId, status])
}

model StavkaSkladisnogDokumenta {
  id          String @id @default(uuid(7)) @db.Uuid
  firmaId     String @db.Uuid
  dokumentId  String @db.Uuid
  uredajId    String @db.Uuid
  /// stanje uređaja u trenutku izdavanja (za ispis i povijest)
  staroStanje String

  firma    Firma             @relation(fields: [firmaId], references: [id])
  dokument SkladisniDokument @relation(fields: [firmaId, dokumentId], references: [firmaId, id])
  uredaj   Uredaj            @relation(fields: [firmaId, uredajId], references: [firmaId, id])

  @@unique([dokumentId, uredajId])
  @@index([firmaId, uredajId])
}

/// Zahtjev koji mora odobriti DRUGI korisnik (npr. izlaz/otpis uređaja).
model Odobrenje {
  id        String    @id @default(uuid(7)) @db.Uuid
  firmaId   String    @db.Uuid
  /// vrsta zahtjeva (izlaz…) i zapis na koji se odnosi
  vrsta     String
  entitet   String
  entitetId String    @db.Uuid
  opis      String
  /// CEKA, ODOBRENO, ODBIJENO
  status    String    @default("CEKA")
  podnioId  String?   @db.Uuid
  podnio    String
  odlucioId String?   @db.Uuid
  odlucio   String?
  razlog    String?
  stvoreno  DateTime  @default(now()) @db.Timestamptz(3)
  odluceno  DateTime? @db.Timestamptz(3)

  firma Firma @relation(fields: [firmaId], references: [id])

  @@unique([firmaId, id])
  @@index([firmaId, status, stvoreno(sort: Desc)])
  @@index([firmaId, entitet, entitetId])
}

/// Inventura jednog skladišta: skenira se što je stvarno na polici, zatvaranjem se uspoređuje s programom.
model Inventura {
  id          String    @id @default(uuid(7)) @db.Uuid
  firmaId     String    @db.Uuid
  /// INV-2/2026
  broj        String
  godina      Int
  redni       Int
  datum       DateTime  @db.Date
  skladisteId String    @db.Uuid
  /// OTVORENA, ZAKLJUCENA
  status      String    @default("OTVORENA")
  napomena    String?
  /// zbrojevi pri zaključenju
  ocekivano   Int?
  pronadjeno  Int?
  manjak      Int?
  visak       Int?
  korisnikId  String?   @db.Uuid
  korisnik    String    @default("Sustav")
  stvoreno    DateTime  @default(now()) @db.Timestamptz(3)
  zakljuceno  DateTime? @db.Timestamptz(3)

  firma     Firma             @relation(fields: [firmaId], references: [id])
  skladiste Skladiste         @relation(fields: [firmaId, skladisteId], references: [firmaId, id])
  stavke    StavkaInventure[]

  @@unique([firmaId, id])
  @@unique([firmaId, godina, redni])
  @@index([firmaId, datum(sort: Desc)])
}

model StavkaInventure {
  id          String   @id @default(uuid(7)) @db.Uuid
  firmaId     String   @db.Uuid
  inventuraId String   @db.Uuid
  serijski    String
  /// null = serijski nije u programu
  uredajId    String?  @db.Uuid
  /// PRONADJEN, MANJAK (očekivan, nije skeniran), VISAK (skeniran, a nije očekivan ovdje), NEPOZNAT (nije u programu)
  rezultat    String?
  /// stanje i skladište u programu pri zaključenju (za izvještaj)
  stanje      String?
  skladiste   String?
  skenirano   Int      @default(1)
  vrijeme     DateTime @default(now()) @db.Timestamptz(3)

  firma     Firma     @relation(fields: [firmaId], references: [id])
  inventura Inventura @relation(fields: [firmaId, inventuraId], references: [firmaId, id])
  uredaj    Uredaj?   @relation(fields: [firmaId, uredajId], references: [firmaId, id])

  @@unique([inventuraId, serijski])
  @@index([firmaId, uredajId])
}

/// Prodajni dokument: ponuda, predračun, račun (i kasnije storno, odobrenje, predujam).
/// Nacrt se smije mijenjati; izdani je zaključan i pamti podatke firme i kupca u trenutku izdavanja.
model ProdajniDokument {
  id             String    @id @default(uuid(7)) @db.Uuid
  firmaId        String    @db.Uuid
  /// PONUDA, PREDRACUN, RACUN…
  vrsta          String
  /// NACRT, IZDAN, STORNIRAN…
  status         String    @default("NACRT")
  /// broj tek pri izdavanju (nacrt nema broj)
  broj           String?
  godina         Int?
  redni          Int?
  datum          DateTime  @db.Date
  /// ponuda: vrijedi do; predračun/račun: dospijeće
  vrijediDo      DateTime? @db.Date
  dospijece      DateTime? @db.Date
  partnerId      String?   @db.Uuid
  poslovnicaId   String?   @db.Uuid
  /// popust na cijeli dokument, stotinke postotka
  popust         Int       @default(0)
  napomena       String?
  /// T transakcijski, G gotovina, K kartica, O ostalo (fiskalizacija)
  nacinPlacanja  String    @default("T")
  osnovica       Decimal   @default(0) @db.Decimal(14, 2)
  pdv            Decimal   @default(0) @db.Decimal(14, 2)
  ukupno         Decimal   @default(0) @db.Decimal(14, 2)
  /// zbroj neponištenih uplata (održava se u istoj transakciji kao uplata) — za popis otvorenih računa
  placeno        Decimal   @default(0) @db.Decimal(14, 2)
  /// podaci firme, kupca i tekstovi u trenutku izdavanja (izdani dokument se ne mijenja kad se promijene postavke)
  snimka         Json?
  /// dokument iz kojeg je nastao (ponuda → predračun → račun)
  izvorId        String?   @db.Uuid
  verzija        Int       @default(0)
  korisnikId     String?   @db.Uuid
  korisnik       String    @default("Sustav")
  izdano         DateTime? @db.Timestamptz(3)
  /// fiskalizacija: NIJE_POTREBNO, CEKA (naknadna dostava), FISKALIZIRAN; ZKI se računa pri izdavanju, JIR vraća CIS
  fiskalStatus   String?
  zki            String?   @db.Char(32)
  jir            String?
  oibOperatera   String?   @db.Char(11)
  fiskalPokusaja Int       @default(0)
  fiskalGreska   String?
  fiskalSljedeci DateTime? @db.Timestamptz(3)
  /// slanje u tijeku do (zauzimanje: isti račun ne šalju istovremeno dva procesa)
  fiskalSaljeDo  DateTime? @db.Timestamptz(3)
  /// račun za najam: ugovor čije su rate na računu
  ugovorNajmaId  String?   @db.Uuid
  stvoreno       DateTime  @default(now()) @db.Timestamptz(3)
  azurirano      DateTime  @updatedAt @db.Timestamptz(3)

  firma       Firma                      @relation(fields: [firmaId], references: [id])
  partner     Partner?                   @relation(fields: [firmaId, partnerId], references: [firmaId, id])
  poslovnica  Poslovnica?                @relation(fields: [firmaId, poslovnicaId], references: [firmaId, id])
  stavke      StavkaProdajnogDokumenta[]
  uplate      Uplata[]
  slanja      SlanjeEposte[]
  eRacuni     ERacun[]
  eIzvjestaji EIzvjestaj[]

  @@unique([firmaId, id])
  /// broj uključuje oznaku prostora i uređaja (redni kreće od 1 za svaki novi prostor/uređaj)
  @@unique([firmaId, vrsta, godina, broj])
  @@index([firmaId, vrsta, datum(sort: Desc)])
  @@index([firmaId, partnerId])
  @@index([firmaId, izvorId])
  @@index([fiskalStatus, fiskalSljedeci])
  @@index([firmaId, ugovorNajmaId])
}

model StavkaProdajnogDokumenta {
  id              String  @id @default(uuid(7)) @db.Uuid
  firmaId         String  @db.Uuid
  dokumentId      String  @db.Uuid
  redoslijed      Int
  /// UREDAJ (točno taj serijski), MODEL, USLUGA, RUCNA
  vrsta           String
  /// PRODAJA ili NAJAM
  namjena         String  @default("PRODAJA")
  uredajId        String? @db.Uuid
  modelId         String? @db.Uuid
  uslugaId        String? @db.Uuid
  naziv           String
  opis            String?
  kpd             String?
  jedinica        String  @default("kom")
  /// tisućinke (1 kom = 1000)
  kolicina        Int
  cijena          Decimal @db.Decimal(14, 2)
  /// stotinke postotka
  popust          Int     @default(0)
  /// ROBA ili USLUGA (najam je usluga)
  vrstaIsporuke   String
  /// stopa i kategorija PDV-a (src/domain/pdv.ts)
  stopa           Int
  kategorija      String
  /// iznos bez PDV-a nakon popusta
  iznos           Decimal @db.Decimal(14, 2)
  /// odobrenje/storno: stavka izvornog računa na koju se odnosi
  izvornaStavkaId String? @db.Uuid

  firma    Firma            @relation(fields: [firmaId], references: [id])
  dokument ProdajniDokument @relation(fields: [firmaId, dokumentId], references: [firmaId, id])
  uredaj   Uredaj?          @relation(fields: [firmaId, uredajId], references: [firmaId, id])
  model    ModelUredaja?    @relation(fields: [firmaId, modelId], references: [firmaId, id])
  usluga   Usluga?          @relation(fields: [firmaId, uslugaId], references: [firmaId, id])

  uredaji UredajNaStavci[]

  @@unique([firmaId, id])
  @@index([dokumentId, redoslijed])
  @@index([firmaId, uredajId])
}

/// Uređaji na grupiranoj stavci računa („isti model = jedna stavka s količinom“).
model UredajNaStavci {
  id       String @id @default(uuid(7)) @db.Uuid
  firmaId  String @db.Uuid
  stavkaId String @db.Uuid
  uredajId String @db.Uuid

  firma  Firma                    @relation(fields: [firmaId], references: [id])
  stavka StavkaProdajnogDokumenta @relation(fields: [firmaId, stavkaId], references: [firmaId, id])
  uredaj Uredaj                   @relation(fields: [firmaId, uredajId], references: [firmaId, id])

  @@unique([stavkaId, uredajId])
  @@index([firmaId, uredajId])
}

/// Uplata kupca po računu (pozitivna) ili povrat kupcu (negativan). Poništena ostaje zapisana.
model Uplata {
  id               String   @id @default(uuid(7)) @db.Uuid
  firmaId          String   @db.Uuid
  dokumentId       String   @db.Uuid
  datum            DateTime @db.Date
  iznos            Decimal  @db.Decimal(14, 2)
  /// T transakcijski, G gotovina, K kartica, O ostalo
  nacin            String   @default("T")
  opis             String?
  ponistena        Boolean  @default(false)
  razlogPonistenja String?
  korisnikId       String?  @db.Uuid
  korisnik         String   @default("Sustav")
  stvoreno         DateTime @default(now()) @db.Timestamptz(3)

  firma    Firma            @relation(fields: [firmaId], references: [id])
  dokument ProdajniDokument @relation(fields: [firmaId, dokumentId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@index([firmaId, dokumentId])
  @@index([firmaId, datum(sort: Desc)])
}

/// Dnevnik slanja e-pošte uz dokument.
model SlanjeEposte {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  dokumentId String   @db.Uuid
  /// predložak (RACUN, PLACEN, STORNO…)
  vrsta      String
  prima      String
  predmet    String
  /// POSLANO, GRESKA, MAILTO (otvoreno u programu za poštu)
  status     String
  greska     String?
  korisnikId String?  @db.Uuid
  korisnik   String   @default("Sustav")
  vrijeme    DateTime @default(now()) @db.Timestamptz(3)

  firma    Firma            @relation(fields: [firmaId], references: [id])
  dokument ProdajniDokument @relation(fields: [firmaId, dokumentId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@index([firmaId, dokumentId, vrijeme(sort: Desc)])
}

/// eRačun (izlazni) poslan preko informacijskog posrednika — korak 2.11. XML se čuva kako je poslan (arhiva 11 godina).
model ERacun {
  id          String    @id @default(uuid(7)) @db.Uuid
  firmaId     String    @db.Uuid
  dokumentId  String    @db.Uuid
  /// POSLAN, ISPORUCEN, PRIHVACEN, ODBIJEN, GRESKA
  status      String
  posrednik   String
  posrednikId String?
  poruka      String?
  xml         String
  korisnikId  String?   @db.Uuid
  korisnik    String    @default("Sustav")
  poslano     DateTime  @default(now()) @db.Timestamptz(3)
  provjereno  DateTime? @db.Timestamptz(3)

  firma    Firma            @relation(fields: [firmaId], references: [id])
  dokument ProdajniDokument @relation(fields: [firmaId, dokumentId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@index([firmaId, dokumentId, poslano(sort: Desc)])
  @@index([firmaId, status])
}

/// eIzvještavanje Poreznoj upravi o naplati i odbijanju eRačuna (preko posrednika).
model EIzvjestaj {
  id          String    @id @default(uuid(7)) @db.Uuid
  firmaId     String    @db.Uuid
  dokumentId  String    @db.Uuid
  /// NAPLATA, ODBIJANJE
  vrsta       String
  iznos       Decimal   @db.Decimal(14, 2)
  datum       DateTime  @db.Date
  razlog      String?
  /// CEKA, POSLAN, GRESKA
  status      String    @default("CEKA")
  posrednikId String?
  poruka      String?
  uplataId    String?   @db.Uuid
  stvoreno    DateTime  @default(now()) @db.Timestamptz(3)
  poslano     DateTime? @db.Timestamptz(3)

  firma    Firma            @relation(fields: [firmaId], references: [id])
  dokument ProdajniDokument @relation(fields: [firmaId, dokumentId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@unique([firmaId, uplataId])
  @@index([firmaId, status])
}

/// Ugovor o najmu (korak 3.2). Broj iz brojača ili ručni (ručni ne troši i ne blokira numeraciju).
model UgovorNajma {
  id                   String    @id @default(uuid(7)) @db.Uuid
  firmaId              String    @db.Uuid
  broj                 String
  /// iz brojača (null = ručni broj)
  redni                Int?
  godina               Int?
  partnerId            String    @db.Uuid
  poslovnicaId         String?   @db.Uuid
  od                   DateTime  @db.Date
  /// kraj ugovora (null = na neodređeno); promjena samo kraja ne dira planove uređaja
  do                   DateTime? @db.Date
  otkazan              DateTime? @db.Date
  razlogOtkaza         String?
  rokPlacanjaDana      Int       @default(15)
  nacinPlacanja        String    @default("T")
  /// uvjeti ugovora (slobodan tekst) i napomena koja ide na račune za najam
  uvjeti               String?
  napomenaRacuna       String?
  /// račun iz prodaje kojim je ugovor otvoren (storno računa briše prazan ugovor)
  izvorDokumentId      String?   @db.Uuid
  /// automatsko izdavanje rata (korak 3.7) od tog dana
  automatski           Boolean   @default(false)
  automatskiOd         DateTime? @db.Date
  /// korisnik koji je uključio automatsko izdavanje (u njegovo ime se izdaje; bez prava → ne izdaje)
  automatskiKorisnikId String?   @db.Uuid
  /// zadnja greška automatskog izdavanja (prikazuje se na ugovoru; briše se kad izdavanje uspije)
  automatskiGreska     String?
  verzija              Int       @default(0)
  korisnikId           String?   @db.Uuid
  korisnik             String    @default("Sustav")
  stvoreno             DateTime  @default(now()) @db.Timestamptz(3)
  azurirano            DateTime  @updatedAt @db.Timestamptz(3)

  firma      Firma       @relation(fields: [firmaId], references: [id])
  partner    Partner     @relation(fields: [firmaId, partnerId], references: [firmaId, id])
  poslovnica Poslovnica? @relation(fields: [firmaId, poslovnicaId], references: [firmaId, id])

  uredaji        UredajNaUgovoru[]
  servisniNalozi ServisniNalog[]

  @@unique([firmaId, id])
  @@unique([firmaId, broj])
  @@index([firmaId, partnerId])
  @@index([firmaId, od(sort: Desc)])
}

/// Uređaj na ugovoru o najmu = plan naplate uređaja (korak 3.3). Isti uređaj može biti na više ugovora u različitim razdobljima.
model UredajNaUgovoru {
  id         String    @id @default(uuid(7)) @db.Uuid
  firmaId    String    @db.Uuid
  ugovorId   String    @db.Uuid
  uredajId   String    @db.Uuid
  /// početak naplate i povrat (null = do kraja ugovora)
  od         DateTime  @db.Date
  do         DateTime? @db.Date
  /// SKLADISTE ili KLIJENT (uređaj je već bio kod klijenta)
  izvor      String    @default("SKLADISTE")
  /// račun iz prodaje koji je uređaj stavio na ugovor (storno računa ga poništava)
  dokumentId String?   @db.Uuid
  napomena   String?
  korisnikId String?   @db.Uuid
  korisnik   String    @default("Sustav")
  stvoreno   DateTime  @default(now()) @db.Timestamptz(3)

  firma   Firma         @relation(fields: [firmaId], references: [id])
  ugovor  UgovorNajma   @relation(fields: [firmaId, ugovorId], references: [firmaId, id])
  uredaj  Uredaj        @relation(fields: [firmaId, uredajId], references: [firmaId, id])
  cijene  CijenaNajma[]
  mjeseci MjesecNajma[]
  rate    RataNajma[]

  @@unique([firmaId, id])
  @@index([firmaId, ugovorId])
  @@index([firmaId, uredajId])
}

/// Mjesečna cijena plana od mjeseca (prvi dan mjeseca); vrijedi do sljedeće promjene.
model CijenaNajma {
  id      String   @id @default(uuid(7)) @db.Uuid
  firmaId String   @db.Uuid
  planId  String   @db.Uuid
  od      DateTime @db.Date
  iznos   Decimal  @db.Decimal(14, 2)

  firma Firma           @relation(fields: [firmaId], references: [id])
  plan  UredajNaUgovoru @relation(fields: [firmaId, planId], references: [firmaId, id], onDelete: Cascade)

  @@unique([firmaId, planId, od])
}

/// Iznimka za mjesec: pauza ili ručni iznos.
model MjesecNajma {
  id      String   @id @default(uuid(7)) @db.Uuid
  firmaId String   @db.Uuid
  planId  String   @db.Uuid
  mjesec  DateTime @db.Date
  pauza   Boolean  @default(false)
  iznos   Decimal? @db.Decimal(14, 2)

  firma Firma           @relation(fields: [firmaId], references: [id])
  plan  UredajNaUgovoru @relation(fields: [firmaId, planId], references: [firmaId, id], onDelete: Cascade)

  @@unique([firmaId, planId, mjesec])
}

/// Izdana (fakturirana) rata: jedinstvena po planu i mjesecu — ista rata se ne može naplatiti dvaput.
model RataNajma {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  planId     String   @db.Uuid
  mjesec     DateTime @db.Date
  iznos      Decimal  @db.Decimal(14, 2)
  /// račun (stavka) kojim je naplaćena; null = „izdano izvan programa“
  dokumentId String?  @db.Uuid
  stavkaId   String?  @db.Uuid
  korisnikId String?  @db.Uuid
  korisnik   String   @default("Sustav")
  stvoreno   DateTime @default(now()) @db.Timestamptz(3)

  firma Firma           @relation(fields: [firmaId], references: [id])
  plan  UredajNaUgovoru @relation(fields: [firmaId, planId], references: [firmaId, id])

  @@unique([firmaId, planId, mjesec])
  @@index([firmaId, dokumentId])
}

/// Narudžbenica dobavljaču (korak 4.2); primke se vežu na nju (djelomično zaprimanje).
model Narudzbenica {
  id          String   @id @default(uuid(7)) @db.Uuid
  firmaId     String   @db.Uuid
  /// NAR-3/2026
  broj        String
  godina      Int
  redni       Int
  datum       DateTime @db.Date
  dobavljacId String   @db.Uuid
  /// HR, EU, UVOZ, BEZ_PDV (prema državi dobavljača u trenutku narudžbe)
  pdvRezim    String
  /// OTVORENA, DJELOMICNO, ZAPRIMLJENA, ZATVORENA, STORNIRANA
  status      String   @default("OTVORENA")
  napomena    String?
  /// zbroj stavki bez PDV-a (osjetljivo — pravo „costs“)
  osnovica    Decimal  @default(0) @db.Decimal(14, 2)
  verzija     Int      @default(0)
  korisnikId  String?  @db.Uuid
  korisnik    String   @default("Sustav")
  stvoreno    DateTime @default(now()) @db.Timestamptz(3)
  azurirano   DateTime @updatedAt @db.Timestamptz(3)

  firma        Firma                @relation(fields: [firmaId], references: [id])
  dobavljac    Partner              @relation(fields: [firmaId, dobavljacId], references: [firmaId, id])
  stavke       StavkaNarudzbenice[]
  primke       Primka[]
  ulazniRacuni UlazniRacun[]

  @@unique([firmaId, id])
  @@unique([firmaId, godina, redni])
  @@index([firmaId, datum(sort: Desc)])
  @@index([firmaId, dobavljacId])
}

model StavkaNarudzbenice {
  id             String  @id @default(uuid(7)) @db.Uuid
  firmaId        String  @db.Uuid
  narudzbenicaId String  @db.Uuid
  redoslijed     Int
  modelId        String  @db.Uuid
  kolicina       Int
  /// nabavna cijena po komadu bez PDV-a
  cijena         Decimal @db.Decimal(14, 2)
  /// broj zaprimljenih uređaja (održava se u istoj transakciji kao primka)
  zaprimljeno    Int     @default(0)

  firma        Firma        @relation(fields: [firmaId], references: [id])
  narudzbenica Narudzbenica @relation(fields: [firmaId, narudzbenicaId], references: [firmaId, id], onDelete: Cascade)
  model        ModelUredaja @relation(fields: [firmaId, modelId], references: [firmaId, id])
  uredaji      Uredaj[]

  @@unique([firmaId, id])
  @@index([firmaId, narudzbenicaId])
}

/// Ulazni račun dobavljača (korak 4.3 ručni, 4.4 eRačun). Oznaka „račun za robu“ ulazi u pravilo troška robe (domain/trosak-robe.ts).
model UlazniRacun {
  id              String    @id @default(uuid(7)) @db.Uuid
  firmaId         String    @db.Uuid
  /// URA-4/2026 (interni broj knjige ulaznih računa)
  interni         String
  godina          Int
  redni           Int
  /// broj računa kod dobavljača
  broj            String
  datum           DateTime  @db.Date
  dospijece       DateTime? @db.Date
  /// dobavljač iz šifrarnika ili slobodnim tekstom (npr. jednokratni)
  dobavljacId     String?   @db.Uuid
  dobavljacTekst  String?
  dobavljacOib    String?   @db.Char(11)
  narudzbenicaId  String?   @db.Uuid
  primkaId        String?   @db.Uuid
  /// „račun za robu“ (inače prijevoz/usluga — uvijek zaseban trošak)
  zaRobu          Boolean   @default(false)
  osnovica        Decimal   @db.Decimal(14, 2)
  pdv             Decimal   @db.Decimal(14, 2)
  ukupno          Decimal   @db.Decimal(14, 2)
  placeno         Decimal   @default(0) @db.Decimal(14, 2)
  opis            String?
  /// RUCNI ili ERACUN
  izvor           String    @default("RUCNI")
  /// EVIDENTIRAN, STORNIRAN; eRačun: PRIMLJEN (čeka prihvat), PRIHVACEN, ODBIJEN
  status          String    @default("EVIDENTIRAN")
  razlogOdbijanja String?
  eRacunId        String?
  xml             String?
  /// eIzvještavanje o odbijanju (id kod posrednika)
  izvjestajId     String?
  verzija         Int       @default(0)
  korisnikId      String?   @db.Uuid
  korisnik        String    @default("Sustav")
  stvoreno        DateTime  @default(now()) @db.Timestamptz(3)
  azurirano       DateTime  @updatedAt @db.Timestamptz(3)

  firma        Firma             @relation(fields: [firmaId], references: [id])
  dobavljac    Partner?          @relation(fields: [firmaId, dobavljacId], references: [firmaId, id])
  narudzbenica Narudzbenica?     @relation(fields: [firmaId, narudzbenicaId], references: [firmaId, id])
  primka       Primka?           @relation(fields: [firmaId, primkaId], references: [firmaId, id])
  placanja     PlacanjeUlaznog[]

  @@unique([firmaId, id])
  @@unique([firmaId, godina, redni])
  @@unique([firmaId, eRacunId])
  @@index([firmaId, datum(sort: Desc)])
  @@index([firmaId, narudzbenicaId])
}

/// Plaćanje ulaznog računa (tek nakon prihvata eRačuna).
model PlacanjeUlaznog {
  id            String   @id @default(uuid(7)) @db.Uuid
  firmaId       String   @db.Uuid
  ulazniRacunId String   @db.Uuid
  datum         DateTime @db.Date
  iznos         Decimal  @db.Decimal(14, 2)
  ponisteno     Boolean  @default(false)
  korisnikId    String?  @db.Uuid
  korisnik      String   @default("Sustav")
  stvoreno      DateTime @default(now()) @db.Timestamptz(3)

  firma Firma       @relation(fields: [firmaId], references: [id])
  racun UlazniRacun @relation(fields: [firmaId, ulazniRacunId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@index([firmaId, ulazniRacunId])
}

/// Kategorija troška (korak 4.5).
model KategorijaTroska {
  id      String  @id @default(uuid(7)) @db.Uuid
  firmaId String  @db.Uuid
  naziv   String
  aktivna Boolean @default(true)

  firma        Firma                @relation(fields: [firmaId], references: [id])
  troskovi     Trosak[]
  ponavljajuci PonavljajuciTrosak[]

  @@unique([firmaId, id])
  @@unique([firmaId, naziv])
}

/// Ručni ili ponavljajući trošak (troškovi robe, primki i ulaznih računa računaju se iz svojih dokumenata).
model Trosak {
  id             String    @id @default(uuid(7)) @db.Uuid
  firmaId        String    @db.Uuid
  datum          DateTime  @db.Date
  kategorijaId   String    @db.Uuid
  opis           String
  /// bez PDV-a; PDV zasebno (pretporez)
  iznos          Decimal   @db.Decimal(14, 2)
  pdv            Decimal   @default(0) @db.Decimal(14, 2)
  /// plaćeno (može se i vratiti na neplaćeno)
  placeno        Boolean   @default(false)
  datumPlacanja  DateTime? @db.Date
  ponavljajuciId String?   @db.Uuid
  /// mjesec ponavljajućeg troška (jedan trošak po mjesecu)
  mjesec         DateTime? @db.Date
  korisnikId     String?   @db.Uuid
  korisnik       String    @default("Sustav")
  stvoreno       DateTime  @default(now()) @db.Timestamptz(3)

  firma        Firma               @relation(fields: [firmaId], references: [id])
  kategorija   KategorijaTroska    @relation(fields: [firmaId, kategorijaId], references: [firmaId, id])
  ponavljajuci PonavljajuciTrosak? @relation(fields: [firmaId, ponavljajuciId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@unique([firmaId, ponavljajuciId, mjesec])
  @@index([firmaId, datum(sort: Desc)])
}

/// Ponavljajući mjesečni trošak (npr. najam prostora): stvara se sam, jednom po mjesecu.
model PonavljajuciTrosak {
  id           String    @id @default(uuid(7)) @db.Uuid
  firmaId      String    @db.Uuid
  kategorijaId String    @db.Uuid
  opis         String
  iznos        Decimal   @db.Decimal(14, 2)
  pdv          Decimal   @default(0) @db.Decimal(14, 2)
  dan          Int
  od           DateTime  @db.Date
  do           DateTime? @db.Date
  /// zadnji mjesec za koji je trošak stvoren
  zadnji       DateTime? @db.Date
  aktivan      Boolean   @default(true)
  korisnikId   String?   @db.Uuid
  korisnik     String    @default("Sustav")
  stvoreno     DateTime  @default(now()) @db.Timestamptz(3)

  firma      Firma            @relation(fields: [firmaId], references: [id])
  kategorija KategorijaTroska @relation(fields: [firmaId, kategorijaId], references: [firmaId, id])
  troskovi   Trosak[]

  @@unique([firmaId, id])
}

/// Predaja dokumenata knjigovođi za mjesec (ZIP ili e-pošta): „označi poslano“.
model PredajaKnjigovodji {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  /// prvi dan mjeseca
  mjesec     DateTime @db.Date
  /// ZIP, EPOSTA, RUCNO
  nacin      String
  prima      String?
  izlaznih   Int
  ulaznih    Int
  korisnikId String?  @db.Uuid
  korisnik   String   @default("Sustav")
  vrijeme    DateTime @default(now()) @db.Timestamptz(3)

  firma Firma @relation(fields: [firmaId], references: [id])

  @@unique([firmaId, id])
  @@index([firmaId, mjesec])
}

/// Servisni nalog (korak 5.1): uređaj na servisu, statusi, zamjenski uređaj, završetak.
model ServisniNalog {
  id                String        @id @default(uuid(7)) @db.Uuid
  firmaId           String        @db.Uuid
  /// SRV-3/2026
  broj              String
  godina            Int
  redni             Int
  datum             DateTime      @db.Date
  uredajId          String        @db.Uuid
  /// kupac ili najmoprimac (null = naš uređaj sa skladišta)
  partnerId         String?       @db.Uuid
  /// ugovor o najmu na kojem je uređaj bio pri prijemu
  ugovorNajmaId     String?       @db.Uuid
  stanjePrije       StanjeUredaja
  /// ZAPRIMLJEN, DIJAGNOZA, CEKA_DIJELOVE, POPRAVAK, GOTOV, VRACEN, OTPISAN, OTKAZAN
  status            String        @default("ZAPRIMLJEN")
  opisKvara         String
  /// interna dijagnoza — nikad na portalu
  dijagnoza         String?
  /// napomena klijentu — vidi se na portalu
  napomenaKlijentu  String?
  kontakt           String?
  /// PROGRAM ili PORTAL
  izvor             String        @default("PROGRAM")
  zamjenskiUredajId String?       @db.Uuid
  zamjenaOd         DateTime?     @db.Date
  zamjenaDo         DateTime?     @db.Date
  imaoZamjenu       Boolean       @default(false)
  zatvoren          DateTime?     @db.Date
  verzija           Int           @default(0)
  korisnikId        String?       @db.Uuid
  korisnik          String        @default("Sustav")
  stvoreno          DateTime      @default(now()) @db.Timestamptz(3)
  azurirano         DateTime      @updatedAt @db.Timestamptz(3)

  firma     Firma            @relation(fields: [firmaId], references: [id])
  uredaj    Uredaj           @relation("NalogUredaj", fields: [firmaId, uredajId], references: [firmaId, id])
  zamjenski Uredaj?          @relation("NalogZamjena", fields: [firmaId, zamjenskiUredajId], references: [firmaId, id])
  partner   Partner?         @relation(fields: [firmaId, partnerId], references: [firmaId, id])
  ugovor    UgovorNajma?     @relation(fields: [firmaId, ugovorNajmaId], references: [firmaId, id])
  dogadaji  DogadajServisa[]

  @@unique([firmaId, id])
  @@unique([firmaId, godina, redni])
  @@index([firmaId, status])
  @@index([firmaId, uredajId])
  @@index([firmaId, partnerId])
  @@index([firmaId, datum(sort: Desc)])
}

/// Tijek servisnog naloga; javni događaji vide se klijentu na portalu.
model DogadajServisa {
  id         String   @id @default(uuid(7)) @db.Uuid
  firmaId    String   @db.Uuid
  nalogId    String   @db.Uuid
  vrijeme    DateTime @default(now()) @db.Timestamptz(3)
  status     String?
  opis       String
  javno      Boolean  @default(true)
  korisnikId String?  @db.Uuid
  korisnik   String   @default("Sustav")

  firma Firma         @relation(fields: [firmaId], references: [id])
  nalog ServisniNalog @relation(fields: [firmaId, nalogId], references: [firmaId, id], onDelete: Cascade)

  @@index([firmaId, nalogId, vrijeme])
}

/// Klijent na portalu (korak 5.2): prijava odvojena od korisnika programa, vidi samo podatke svog partnera.
model KorisnikPortala {
  id              String    @id @default(uuid(7)) @db.Uuid
  firmaId         String    @db.Uuid
  partnerId       String    @db.Uuid
  ime             String
  /// mala slova; jedinstven u firmi
  email           String
  /// null dok klijent ne postavi lozinku preko poveznice
  lozinkaHash     String?
  aktivan         Boolean   @default(true)
  /// poveznica za postavljanje lozinke (hash tokena) i istek
  poveznicaHash   String?   @unique
  poveznicaIstice DateTime? @db.Timestamptz(3)
  zadnjaPrijava   DateTime? @db.Timestamptz(3)
  korisnikId      String?   @db.Uuid
  korisnik        String    @default("Sustav")
  stvoreno        DateTime  @default(now()) @db.Timestamptz(3)
  azurirano       DateTime  @updatedAt @db.Timestamptz(3)

  firma   Firma           @relation(fields: [firmaId], references: [id])
  partner Partner         @relation(fields: [firmaId, partnerId], references: [firmaId, id])
  sesije  SesijaPortala[]

  @@unique([firmaId, id])
  @@unique([firmaId, email])
  @@index([email])
  @@index([firmaId, partnerId])
}

/// Sesija klijenta na portalu (id = hash tokena iz kolačića „erp_portal“).
model SesijaPortala {
  id                String   @id
  firmaId           String   @db.Uuid
  korisnikPortalaId String   @db.Uuid
  istjece           DateTime @db.Timestamptz(3)
  zadnjaAktivnost   DateTime @db.Timestamptz(3)
  ip                String?
  preglednik        String?
  stvoreno          DateTime @default(now()) @db.Timestamptz(3)

  firma    Firma           @relation(fields: [firmaId], references: [id])
  korisnik KorisnikPortala @relation(fields: [firmaId, korisnikPortalaId], references: [firmaId, id], onDelete: Cascade)

  @@index([korisnikPortalaId])
}

/// MDM organizacija (korak 5.5): distributer ili klijent; klijent može biti pod distributerom.
model MdmOrganizacija {
  id          String   @id @default(uuid(7)) @db.Uuid
  firmaId     String   @db.Uuid
  naziv       String
  /// DISTRIBUTER ili KLIJENT
  vrsta       String
  nadredenaId String?  @db.Uuid
  /// partner čiji korisnici portala vide ovu organizaciju i sve ispod nje
  partnerId   String?  @db.Uuid
  /// kod za upis uređaja (agent ga upisuje ili skenira QR) — jedinstven u cijelom sustavu
  kodUpisa    String   @unique
  aktivna     Boolean  @default(true)
  korisnikId  String?  @db.Uuid
  korisnik    String   @default("Sustav")
  stvoreno    DateTime @default(now()) @db.Timestamptz(3)
  azurirano   DateTime @updatedAt @db.Timestamptz(3)

  firma     Firma             @relation(fields: [firmaId], references: [id])
  nadredena MdmOrganizacija?  @relation("MdmStablo", fields: [firmaId, nadredenaId], references: [firmaId, id])
  podredene MdmOrganizacija[] @relation("MdmStablo")
  partner   Partner?          @relation(fields: [firmaId, partnerId], references: [firmaId, id])
  uredaji   MdmUredaj[]
  profili   MdmProfil[]
  dodjele   MdmDodjela[]
  datoteke  MdmDatoteka[]

  @@unique([firmaId, id])
  @@index([firmaId, nadredenaId])
  @@index([firmaId, partnerId])
}

/// Uređaj upisan u MDM (agent na Androidu ili Windowsu); autentikacija agenta tokenom (u bazi samo hash).
model MdmUredaj {
  id             String    @id @default(uuid(7)) @db.Uuid
  firmaId        String    @db.Uuid
  organizacijaId String    @db.Uuid
  /// uređaj iz skladišta s istim serijskim (ako postoji)
  uredajId       String?   @db.Uuid
  serijski       String
  naziv          String?
  /// ANDROID ili WINDOWS
  platforma      String
  model          String?
  osVerzija      String?
  verzijaAgenta  String?
  tokenHash      String    @unique
  /// zaposlenik je dopustio ponovni upis (i u drugu organizaciju) — jednokratno
  ponovniUpis    Boolean   @default(false)
  /// AKTIVAN ili BLOKIRAN
  stanje         String    @default("AKTIVAN")
  zadnjiKontakt  DateTime? @db.Timestamptz(3)
  /// zadnje stanje koje je agent javio (baterija, prostor, IP, aplikacije…)
  izvjestaj      Json      @default("{}")
  upisan         DateTime  @default(now()) @db.Timestamptz(3)
  azurirano      DateTime  @updatedAt @db.Timestamptz(3)

  firma        Firma           @relation(fields: [firmaId], references: [id])
  organizacija MdmOrganizacija @relation(fields: [firmaId, organizacijaId], references: [firmaId, id])
  uredaj       Uredaj?         @relation(fields: [firmaId, uredajId], references: [firmaId, id])
  naredbe      MdmNaredba[]
  zapisi       MdmZapis[]
  snimke       MdmSnimka[]

  @@unique([firmaId, id])
  @@unique([firmaId, serijski])
  @@index([firmaId, organizacijaId])
}

/// MDM profil (konfiguracija) za platformu; organizacija null = za sve. Agent dobiva važeći (najbliži) profil.
model MdmProfil {
  id             String   @id @default(uuid(7)) @db.Uuid
  firmaId        String   @db.Uuid
  organizacijaId String?  @db.Uuid
  naziv          String
  platforma      String
  /// PostavkeProfila (src/domain/mdm-upravljanje.ts)
  postavke       Json     @default("{}")
  /// lozinka Wi-Fi mreže, šifrirana (src/lib/tajne.ts) — nikad u preglednik ni dnevnik
  wifiLozinka    String?
  verzija        Int      @default(1)
  aktivan        Boolean  @default(true)
  korisnikId     String?  @db.Uuid
  korisnik       String   @default("Sustav")
  stvoreno       DateTime @default(now()) @db.Timestamptz(3)
  azurirano      DateTime @updatedAt @db.Timestamptz(3)

  firma        Firma            @relation(fields: [firmaId], references: [id])
  organizacija MdmOrganizacija? @relation(fields: [firmaId, organizacijaId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@index([firmaId, organizacijaId])
}

/// Verzija aplikacije (APK za Android, MSI za Windows); svaka nova verzija je novi redak.
model MdmAplikacija {
  id            String   @id @default(uuid(7)) @db.Uuid
  firmaId       String   @db.Uuid
  naziv         String
  /// Android: naziv paketa; Windows: kod proizvoda MSI ili dogovoreni naziv
  paket         String
  platforma     String
  verzija       String
  /// raste sa svakom verzijom (Android versionCode)
  verzijaKod    Int
  nazivDatoteke String
  sadrzaj       Bytes
  velicina      Int
  sha256        String
  korisnikId    String?  @db.Uuid
  korisnik      String   @default("Sustav")
  stvoreno      DateTime @default(now()) @db.Timestamptz(3)

  firma Firma @relation(fields: [firmaId], references: [id])

  @@unique([firmaId, id])
  @@unique([firmaId, paket, platforma, verzijaKod])
}

/// Aplikacija (paket) dodijeljena organizaciji — uređaji dobivaju uvijek najnoviju verziju.
model MdmDodjela {
  id             String @id @default(uuid(7)) @db.Uuid
  firmaId        String @db.Uuid
  organizacijaId String @db.Uuid
  paket          String
  platforma      String

  firma        Firma           @relation(fields: [firmaId], references: [id])
  organizacija MdmOrganizacija @relation(fields: [firmaId, organizacijaId], references: [firmaId, id], onDelete: Cascade)

  @@unique([firmaId, organizacijaId, paket, platforma])
}

/// Datoteka koju agent sprema u zadanu mapu na uređajima organizacije.
model MdmDatoteka {
  id             String   @id @default(uuid(7)) @db.Uuid
  firmaId        String   @db.Uuid
  organizacijaId String   @db.Uuid
  naziv          String
  putanja        String
  sadrzaj        Bytes
  velicina       Int
  sha256         String
  korisnikId     String?  @db.Uuid
  korisnik       String   @default("Sustav")
  stvoreno       DateTime @default(now()) @db.Timestamptz(3)

  firma        Firma           @relation(fields: [firmaId], references: [id])
  organizacija MdmOrganizacija @relation(fields: [firmaId, organizacijaId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@index([firmaId, organizacijaId])
}

/// Naredba uređaju: CEKA → POSLANA (pri javljanju) → IZVRSENA / GRESKA (agent javlja rezultat); ili OTKAZANA.
model MdmNaredba {
  id          String    @id @default(uuid(7)) @db.Uuid
  firmaId     String    @db.Uuid
  mdmUredajId String    @db.Uuid
  vrsta       String
  parametri   Json      @default("{}")
  status      String    @default("CEKA")
  rezultat    String?
  korisnikId  String?   @db.Uuid
  korisnik    String    @default("Sustav")
  stvoreno    DateTime  @default(now()) @db.Timestamptz(3)
  poslano     DateTime? @db.Timestamptz(3)
  zavrseno    DateTime? @db.Timestamptz(3)

  firma  Firma     @relation(fields: [firmaId], references: [id])
  uredaj MdmUredaj @relation(fields: [firmaId, mdmUredajId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@index([firmaId, mdmUredajId, status])
}

/// Zapisnik agenta.
model MdmZapis {
  id          String   @id @default(uuid(7)) @db.Uuid
  firmaId     String   @db.Uuid
  mdmUredajId String   @db.Uuid
  vrijeme     DateTime @db.Timestamptz(3)
  /// INFO, UPOZORENJE, GRESKA
  razina      String
  poruka      String
  primljeno   DateTime @default(now()) @db.Timestamptz(3)

  firma  Firma     @relation(fields: [firmaId], references: [id])
  uredaj MdmUredaj @relation(fields: [firmaId, mdmUredajId], references: [firmaId, id])

  @@index([firmaId, mdmUredajId, vrijeme(sort: Desc)])
}

/// Snimka zaslona uređaja (naredba SNIMI_ZASLON).
model MdmSnimka {
  id          String   @id @default(uuid(7)) @db.Uuid
  firmaId     String   @db.Uuid
  mdmUredajId String   @db.Uuid
  naredbaId   String?  @db.Uuid
  vrsta       String
  slika       Bytes
  velicina    Int
  vrijeme     DateTime @default(now()) @db.Timestamptz(3)

  firma  Firma     @relation(fields: [firmaId], references: [id])
  uredaj MdmUredaj @relation(fields: [firmaId, mdmUredajId], references: [firmaId, id])

  @@unique([firmaId, id])
  @@index([firmaId, mdmUredajId, vrijeme(sort: Desc)])
}

/// Logo firme (6.5) — svaka nova slika je novi zapis, pa stari dokumenti zadržavaju logo s kojim su izdani.
model LogoFirme {
  id       String   @id @default(uuid(7)) @db.Uuid
  firmaId  String   @db.Uuid
  vrsta    String
  sadrzaj  Bytes
  stvoreno DateTime @default(now()) @db.Timestamptz(3)

  firma Firma @relation(fields: [firmaId], references: [id])

  @@unique([firmaId, id])
}

/// Sigurnosna kopija firme (6.6): gzip NDJSON svih tablica firme; dnevna (zadnjih 14) i ručne (zadnjih 10).
model SigurnosnaKopija {
  id       String   @id @default(uuid(7)) @db.Uuid
  firmaId  String   @db.Uuid
  vrijeme  DateTime @default(now()) @db.Timestamptz(3)
  /// DNEVNA ili RUCNA
  vrsta    String
  velicina Int
  /// broj redaka po tablici (za provjeru nakon vraćanja)
  redaka   Json
  sadrzaj  Bytes
  korisnik String   @default("Sustav")

  firma Firma @relation(fields: [firmaId], references: [id])

  @@unique([firmaId, id])
  @@index([firmaId, vrijeme(sort: Desc)])
}

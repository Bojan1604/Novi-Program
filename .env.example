# Kopirajte u .env. pokreni.bat sam napravi .env sa slučajnom lozinkom baze ako ne postoji.

# Lozinka baze (Docker); ista mora biti u adresama ispod
BAZA_LOZINKA="promijenite-me"

# Baza programa — Docker iz docker-compose.yml
DATABASE_URL="postgresql://erp:promijenite-me@localhost:5432/erp_wms"

# Testna baza: testovi i demo podaci je BRIŠU; ime mora sadržavati „test“
DATABASE_URL_TEST="postgresql://erp:promijenite-me@localhost:5432/erp_wms_test"

# Iza vlastitog proxyja (Caddy, produkcija): 1 = vjeruj X-Forwarded-For/Proto od proxyja
VJERUJ_PROXYJU="0"

# HTTPS bez proxyja (lokalna mreža): kamera na mobitelu radi samo preko https://.
# 1 = samopotpisani certifikat u mapi .https (ili vlastiti: HTTPS_CERT i HTTPS_KLJUC = putanje do datoteka)
HTTPS="1"

# Ključ za šifriranje tajni u bazi (SMTP lozinka, fiskalni certifikat, prijava u dva koraka).
# pokreni.bat i instaliraj.sh ga sami postave; ne mijenjajte ga kasnije (spremite kopiju .env).
TAJNI_KLJUC=""

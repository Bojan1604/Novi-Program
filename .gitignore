# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
!.env.example

# prisma (generira se pri npm install)
/src/generated/

# playwright
/test-results/
/playwright-report/

# skener (kopira scripts/kopiraj-skener.mjs pri npm install)
/public/skener/

# samopotpisani certifikat za HTTPS u lokalnoj mreži
/.https/
.mdm-agent-*.json

# snimke stranica (npm run snimke)
/snimke/

{
  "name": "erp-wms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node posluzitelj/index.mjs",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:seed": "tsx scripts/demo-podaci-test.ts",
    "check:use-server": "tsx scripts/provjera-use-server.ts",
    "db:migrate": "tsx scripts/nova-migracija.ts",
    "db:deploy": "prisma migrate deploy",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:use-server && npm test && npm run test:db && npm run test:seed && npm run build && npm run test:e2e",
    "postinstall": "prisma generate && node scripts/kopiraj-skener.mjs",
    "prepare": "husky",
    "admin:prvi": "tsx scripts/prvi-admin.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:velika": "tsx scripts/velika-baza.ts",
    "mjerenje": "tsx scripts/mjerenje.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "16.3.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "selfsigned": "^5.5.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
